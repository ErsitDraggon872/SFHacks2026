# ==============================================================================
# SwampReserve Environment Configuration
# ==============================================================================

# Google Gemini API key (for live AI extraction and explanation writing).
# If unset, SwampReserve gracefully falls back to deterministic cached demos.
GEMINI_API_KEY=

# Extractor model: fast, structured JSON parsing into EventDraft
GEMINI_EXTRACTOR_MODEL=gemini-3.5-flash-lite

# Writer model: high-quality admin & policy explanations, briefings, and permit drafts
GEMINI_WRITER_MODEL=gemini-3.8-flash

# Anchor date for deterministic time normalization (Monday of the demo week)
DEMO_ANCHOR_DATE=2026-10-05
NEXT_PUBLIC_DEMO_ANCHOR_DATE=2026-10-05
